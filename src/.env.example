# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Lấy token từ @BotFather trên Telegram
STOCKTRACE_TELEGRAM__BOT_TOKEN=replace-me

# Chat ID để nhận alert (tuỳ chọn)
STOCKTRACE_TELEGRAM__CHAT_ID=

# Danh sách user_id được phép dùng bot (để trống = cho phép tất cả)
# Ví dụ: [123456789, 987654321]
STOCKTRACE_TELEGRAM__ALLOWED_USER_IDS=[]

STOCKTRACE_TELEGRAM__POLLING_ENABLED=true
STOCKTRACE_TELEGRAM__DROP_PENDING_UPDATES=true

# ── App ───────────────────────────────────────────────────────────────────────
STOCKTRACE_ENVIRONMENT=development
STOCKTRACE_DEBUG=true

# ── Providers ─────────────────────────────────────────────────────────────────
# Timeout tính bằng giây khi gọi Yahoo Finance API
STOCKTRACE_PROVIDERS__REQUEST_TIMEOUT_SECONDS=10
STOCKTRACE_PROVIDERS__MAX_RETRIES=3

# ── AI Analysis ───────────────────────────────────────────────────────────────
STOCKTRACE_AI__ENABLED=false
STOCKTRACE_AI__PROVIDER=gemini
STOCKTRACE_AI__API_KEY=replace-me
STOCKTRACE_AI__MODEL=gemini-3.6-flash
STOCKTRACE_AI__FALLBACK_MODEL=gemini-3.5-flash
STOCKTRACE_AI__FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
STOCKTRACE_AI__TRANSLATE_NEWS=true
STOCKTRACE_AI__CACHE_TTL_SECONDS=1800
STOCKTRACE_AI__MARKET_CACHE_TTL_SECONDS=1800

# ── Scheduler AI Reports ──────────────────────────────────────────────────────
STOCKTRACE_SCHEDULER__ANALYSIS_ENABLED=false
STOCKTRACE_SCHEDULER__ANALYSIS_SYMBOLS=["VCB","HPG","FPT","MWG"]

# ── Market Analysis ───────────────────────────────────────────────────────────
STOCKTRACE_SCHEDULER__MARKET_ANALYSIS_ENABLED=false
STOCKTRACE_SCHEDULER__MARKET_MORNING_REPORT_HOUR=7
STOCKTRACE_SCHEDULER__MARKET_EVENING_REPORT_HOUR=19
