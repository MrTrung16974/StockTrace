STOCKTRACE_ENVIRONMENT=development
STOCKTRACE_DEBUG=true
STOCKTRACE_APP__NAME=StockTrace
STOCKTRACE_APP__VERSION=0.1.0
STOCKTRACE_API__HOST=0.0.0.0
STOCKTRACE_API__PORT=8000
STOCKTRACE_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
STOCKTRACE_DATABASE__URL=sqlite+aiosqlite:///./data/stocktrace.db
STOCKTRACE_DATABASE__ECHO=false
STOCKTRACE_REDIS__URL=redis://localhost:6379/0
STOCKTRACE_POSTGRES_HOST_PORT=5433
STOCKTRACE_REDIS_HOST_PORT=6380
STOCKTRACE_TELEGRAM__BOT_TOKEN=replace-me
STOCKTRACE_TELEGRAM__CHAT_ID=replace-me
STOCKTRACE_TELEGRAM__ALLOWED_USER_IDS=[]
STOCKTRACE_TELEGRAM__POLLING_ENABLED=true
STOCKTRACE_TELEGRAM__DROP_PENDING_UPDATES=true
STOCKTRACE_SECURITY__API_KEY=replace-me
STOCKTRACE_SECURITY__API_KEY_HEADER=X-API-Key
STOCKTRACE_SECURITY__RATE_LIMIT_PER_MINUTE=120
STOCKTRACE_PROVIDERS__REQUEST_TIMEOUT_SECONDS=10
STOCKTRACE_PROVIDERS__MAX_RETRIES=3
STOCKTRACE_SCHEDULER__ENABLED=true
STOCKTRACE_SCHEDULER__PRICE_ENABLED=true
STOCKTRACE_SCHEDULER__PRICE_ALERT_INTERVAL_MINUTES=1
STOCKTRACE_SCHEDULER__PRICE_CHANGE_THRESHOLD_PERCENT=0.1
STOCKTRACE_SCHEDULER__PRICE_ALERT_COOLDOWN_MINUTES=5
# Paper-order confirmation expiry is disabled until a durable authenticated UI is deployed.
STOCKTRACE_SCHEDULER__PAPER_CONFIRMATION_EXPIRY_ENABLED=false
STOCKTRACE_SCHEDULER__PAPER_CONFIRMATION_EXPIRY_INTERVAL_MINUTES=1
# A configuration flag never enables auto trading alone: an active manual approval,
# stable paper-trading evidence, pre-trade risk approval and every pilot limit are required.
STOCKTRACE_AUTO_TRADE__ENABLED=false
STOCKTRACE_AUTO_TRADE__ALLOWED_SYMBOLS=[]
STOCKTRACE_AUTO_TRADE__MAX_NOTIONAL_PER_ORDER=1000000
STOCKTRACE_AUTO_TRADE__MAX_NOTIONAL_PER_DAY=2000000
STOCKTRACE_AUTO_TRADE__MAX_ORDERS_PER_DAY=1
STOCKTRACE_AUTO_TRADE__MINIMUM_PAPER_OBSERVATION_DAYS=30
STOCKTRACE_AUTO_TRADE__MINIMUM_PAPER_COMPLETED_ORDERS=20
# Runtime control starts killed. This second, operator-only key is required by the
# emergency kill-switch endpoint in addition to the normal X-API-Key.
STOCKTRACE_AUTO_TRADE__ROLLOUT_PERCENTAGE=0
STOCKTRACE_AUTO_TRADE__ROLLOUT_OWNER_IDS=[]
# STOCKTRACE_AUTO_TRADE__CONTROL_KEY=replace-with-a-separate-long-secret
# STOCKTRACE_AUTO_TRADE__CONTROL_OPERATOR_ID=on-call-risk-operator
STOCKTRACE_SCHEDULER__NEWS_ENABLED=true
STOCKTRACE_SCHEDULER__NEWS_DIGEST_HOURS=[8,12,16,20]
STOCKTRACE_SCHEDULER__NEWS_DIGEST_LIMIT=5
STOCKTRACE_SCHEDULER__ANALYSIS_ENABLED=false
STOCKTRACE_SCHEDULER__ANALYSIS_SYMBOLS=["VCB","HPG","FPT","MWG"]
STOCKTRACE_SCHEDULER__MORNING_REPORT_HOUR=8
STOCKTRACE_SCHEDULER__EVENING_REPORT_HOUR=20
STOCKTRACE_SCHEDULER__MARKET_ANALYSIS_ENABLED=false
STOCKTRACE_SCHEDULER__MARKET_DAILY_REPORT_HOUR=16

# ── Google Gemini AI ────────────────────────────────────────────────────────
# Lấy API Key miễn phí tại: https://aistudio.google.com/apikey
# Model chính: Gemini 3.6 Flash. Không dùng các model Gemini 2.0 đã bị retire.
STOCKTRACE_AI__ENABLED=false
STOCKTRACE_AI__PROVIDER=gemini
STOCKTRACE_AI__API_KEY=replace-me
STOCKTRACE_AI__MODEL=gemini-3.6-flash
STOCKTRACE_AI__FALLBACK_MODEL=gemini-3.5-flash
# Khi model chính hết quota/rate-limit hoặc bị retire, thử lần lượt các model này.
STOCKTRACE_AI__FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
STOCKTRACE_AI__MAX_TOKENS=2048
STOCKTRACE_AI__TEMPERATURE=0.3
STOCKTRACE_AI__TRANSLATE_NEWS=true
STOCKTRACE_AI__CACHE_TTL_SECONDS=1800
STOCKTRACE_AI__REPORT_CACHE_TTL_SECONDS=300
